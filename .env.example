# ---- API (apps/api) ----
# Supabase project settings -> API. Use the SERVICE ROLE key on the server only; never ship it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set to "memory" to run the API without a database (used by tests and quick local demos).
STORE_BACKEND=supabase
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Web (apps/web) ----
VITE_API_URL=http://localhost:4000

# ---- MCP server (apps/mcp) ----
STOREFRONT_API_URL=http://localhost:4000
